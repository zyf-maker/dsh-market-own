{
  "name": "dsh-market-own",
  "version": "0.1.0",
  "description": "DSH Market, plugin half: the settings-section market for DeepSeek Harness — browses the published catalog, installs in harness format, and repairs a plugin's compatibility instead of failing. Catalog data and the public page live in dsh-catalog-merged.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/zyf-maker/dsh-market-own.git" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-api-remotes"]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client/client.js",
    "ingest/compat.mjs",
    "cordis.patch.yml",
    "package.json"
  ]
}
